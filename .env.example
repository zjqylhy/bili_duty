# ════════════════════════════════════════════════════════════════════
# 复制成 .env 再填。这个文件**只放密钥**，其它配置在 data/config.json。
# ⚠️ .env 不要提交进 git、不要贴聊天记录。
# ════════════════════════════════════════════════════════════════════

# 模型 key（https://platform.deepseek.com → API keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 控制页「手动跑一轮」的口令：随便一串长随机（openssl rand -hex 24）
# 不填的话 POST /run 会被一律拒绝（GET 只读页仍然可用）
BILIDUTY_TOKEN=change-me-to-a-long-random-string

# ── B站 凭证：二选一 ───────────────────────────────────────────────
# ① 推荐：在服务器上跑 `biliduty login` 扫码，它会写进 data/bili_credential.json
# ② 或者在这里填浏览器里登着 B站 的 cookie（注意：那是你账号的登录态）
# BILI_SESSDATA=
# BILI_JCT=
# BILI_BUVID3=
# BILI_DEDEUSERID=
